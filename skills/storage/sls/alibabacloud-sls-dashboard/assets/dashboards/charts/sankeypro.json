{
  "dashboardName": "example-sankeypro",
  "displayName": "Request flow example",
  "attribute": {
    "type": "grid"
  },
  "charts": [
    {
      "title": "sankeypro",
      "type": "sankeypro",
      "display": {
        "version": 2,
        "xPos": 0,
        "yPos": 0,
        "width": 24,
        "height": 8,
        "basicOptions": {
          "displayName": "Request flow",
          "showTitle": true,
          "showBorder": true,
          "showBackground": true,
          "showTime": true
        },
        "queryOptionMap": {
          "A": {
            "sourceKey": "source",
            "targetKey": "target",
            "numFieldKey": "requests"
          }
        },
        "sankeyOptions": {
          "linkColorMode": "source-target",
          "nodeAlignment": "justify"
        },
        "standardOption": {
          "format": "none",
          "decimals": 0
        }
      },
      "search": {
        "chartQueries": [
          {
            "name": "A",
            "datasource": "logstore",
            "region": "cn-hangzhou",
            "project": "example-project",
            "logstore": "example-logstore",
            "query": "* | select source, target, requests from unnest(array['Web','Web','API','API'], array['API','Cache','Database','Worker'], array[80,20,60,20]) as t(source,target,requests)"
          }
        ],
        "start": "-3600s",
        "end": "now",
        "dataSourceType": "mixed"
      },
      "action": {}
    }
  ]
}
