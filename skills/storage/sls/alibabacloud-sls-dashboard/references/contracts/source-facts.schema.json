{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SLS source facts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "evidence",
    "fields",
    "metrics",
    "warnings"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "region",
        "project",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "logstore",
            "metricstore",
            "metricsql",
            "logstore_storeview",
            "metricstore_storeview"
          ]
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "indexed",
          "analytics",
          "inSample"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "indexed": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "analytics": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "inSample": {
            "type": "boolean"
          }
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "sample": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "api",
              "query",
              "user",
              "dashboard"
            ]
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "window": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "name",
          "fields"
        ],
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "type",
                "indexed",
                "analytics",
                "inSample"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "indexed": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "analytics": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "inSample": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "memberErrors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
