{
  "product": "swas",
  "aliases": [
    "轻量应用服务器",
    "Simple Application Server",
    "SWAS",
    "轻量服务器",
    "sas"
  ],
  "issueTypes": [
    {
      "name": "轻量应用功能咨询",
      "keywords": [
        "功能咨询",
        "带宽限速",
        "跨账号转移",
        "跨地域迁移",
        "安全锁定"
      ],
      "categoryKeywords": [
        "功能",
        "咨询",
        "迁移",
        "限速"
      ],
      "categoryHints": [
        "轻量应用功能咨询"
      ],
      "collect": [
        {
          "field": "regionId",
          "label": "地域",
          "required": true,
          "type": "string",
          "description": "实例所在地域标识，如cn-hangzhou、cn-hongkong",
          "maxLength": 64
        },
        {
          "field": "instanceId",
          "label": "实例标识",
          "required": false,
          "type": "string",
          "description": "涉及具体实例时填写，如i-2zeabc123def",
          "maxLength": 64
        },
        {
          "field": "featureType",
          "label": "咨询功能类型",
          "required": true,
          "type": "string",
          "enum": ["带宽限速", "跨账号迁移", "跨地域迁移", "安全锁定", "其他"],
          "description": "轻量服务器高频咨询：跨账号转移不支持（用自定义/共享镜像迁移）；跨地域需镜像复制后IP会变"
        },
        {
          "field": "bandwidthIssue",
          "label": "带宽问题表现",
          "required": false,
          "type": "string",
          "enum": ["峰值限制", "持续限速", "无法解除", "不涉及"],
          "description": "SWAS带宽为峰值上限非SLA承诺，高峰期可能低于峰值"
        },
        {
          "field": "migrationType",
          "label": "迁移类型",
          "required": false,
          "type": "string",
          "enum": ["跨账号", "跨地域", "不涉及"],
          "description": "跨账号用共享镜像迁移，跨地域需镜像复制到目标地域且IP会变更"
        },
        {
          "field": "hasSnapshot",
          "label": "是否有快照",
          "required": false,
          "type": "boolean",
          "description": "迁移或恢复前是否已创建快照"
        },
        {
          "field": "questionDescription",
          "label": "咨询内容",
          "required": true,
          "type": "string",
          "description": "说明目标、当前情况和具体疑问",
          "maxLength": 1000
        }
      ]
    },
    {
      "name": "远程登录与连接相关问题",
      "keywords": [
        "无法登录",
        "SSH失败",
        "远程连接",
        "跨境链路",
        "登录超时"
      ],
      "categoryKeywords": [
        "登录",
        "连接",
        "SSH",
        "RDP"
      ],
      "categoryHints": [
        "远程登录与连接相关问题"
      ],
      "collect": [
        {
          "field": "instanceId",
          "label": "实例标识",
          "required": true,
          "type": "string",
          "description": "轻量服务器实例标识，如i-2zeabc123def，登录排查必需",
          "maxLength": 64
        },
        {
          "field": "loginIssueType",
          "label": "登录问题类型",
          "required": true,
          "type": "string",
          "enum": ["跨境链路", "SSH失败", "登录凭据无法使用", "RDP失败", "Workbench失败"],
          "description": "跨境链路（内地→香港/海外）是该类最高频原因；凭据类问题只记录无法使用的现象，不采集凭据内容"
        },
        {
          "field": "regionType",
          "label": "实例地域类型",
          "required": true,
          "type": "string",
          "enum": ["国内", "香港", "新加坡", "韩国", "其他"],
          "description": "跨境登录（内地访问香港/海外节点）链路质量差异大"
        },
        {
          "field": "loginMethod",
          "label": "登录方式",
          "required": true,
          "type": "string",
          "enum": ["SSH", "RDP远程桌面", "Workbench", "VNC", "其他"],
          "description": "客户使用的登录方式及具体报错信息"
        },
        {
          "field": "loginAuthorization",
          "label": "是否已授权排查",
          "required": false,
          "type": "boolean",
          "description": "SSH失败需授权工程师登录实例排查，是否已提交授权（授权ID如BS15HKW）"
        },
        {
          "field": "occurrenceTime",
          "label": "发生时间",
          "required": true,
          "type": "string",
          "description": "包含日期、时间和时区",
          "maxLength": 64
        },
        {
          "field": "symptom",
          "label": "异常现象",
          "required": true,
          "type": "string",
          "description": "登录时的具体报错或超时表现，如Connection timed out、Permission denied",
          "maxLength": 1000
        },
        {
          "field": "sourceNetwork",
          "label": "客户端网络环境",
          "required": false,
          "type": "string",
          "description": "客户端所在地区、运营商（如上海电信、家庭宽带）",
          "maxLength": 300
        }
      ]
    },
    {
      "name": "购买/续费/计费/账单/退订问题",
