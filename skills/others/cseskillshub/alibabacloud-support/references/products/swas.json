        {
          "field": "instanceId",
          "label": "实例标识",
          "required": false,
          "type": "string",
          "description": "涉及已有实例的续费/退订问题时填写",
          "maxLength": 64
        },
        {
          "field": "regionId",
          "label": "地域",
          "required": false,
          "type": "string",
          "description": "实例所在地域标识，如cn-hangzhou",
          "maxLength": 64
        },
        {
          "field": "riskControlStatus",
          "label": "风控状态",
          "required": false,
          "type": "string",
