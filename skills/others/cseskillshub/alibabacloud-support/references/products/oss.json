{
  "product": "oss",
  "aliases": [
    "对象存储 OSS",
    "对象存储",
    "OSS",
    "阿里云OSS"
  ],
  "issueTypes": [
    {
      "name": "OSS功能咨询",
      "keywords": [
        "功能咨询",
        "Bucket管理",
        "权限配置",
        "生命周期",
        "防盗链",
        "跨区域复制",
        "如何使用"
      ],
      "categoryKeywords": [
        "功能",
        "咨询",
        "Bucket"
      ],
      "categoryHints": [
        "OSS功能咨询"
      ],
      "collect": [
        {
          "field": "bucketName",
          "label": "Bucket名称",
          "required": true,
          "type": "string",
          "description": "涉及的Bucket名称，用于定位具体资源",
          "maxLength": 64
        },
        {
          "field": "regionId",
          "label": "地域",
          "required": true,
          "type": "string",
          "description": "Bucket所在地域标识，如cn-hangzhou、cn-beijing、cn-shanghai",
          "maxLength": 64
        },
        {
          "field": "requestId",
          "label": "RequestId",
          "required": false,
          "type": "string",
          "description": "请求ID，需在3天内提供（日志保留期限），用于定位请求级问题",
          "maxLength": 120
        },
        {
          "field": "accessControlType",
          "label": "Bucket读写权限",
          "required": false,
          "type": "string",
          "enum": ["公共读写", "公共读私有写", "私有"],
          "description": "Bucket的ACL权限类型，影响安全排查方向"
        },
        {
          "field": "featureName",
          "label": "咨询功能",
          "required": true,
          "type": "string",
          "description": "希望了解或使用的功能名称，如生命周期规则、防盗链、跨区域复制、RAM权限等",
          "maxLength": 120
        },
        {
          "field": "questionDescription",
          "label": "咨询内容",
          "required": true,
          "type": "string",
          "description": "说明目标、当前情况和具体疑问",
          "maxLength": 1000
        },
        {
          "field": "clientLocation",
          "label": "客户端地理位置",
          "required": false,
          "type": "string",
          "description": "客户端所在地区，跨域上传慢时需提供，建议从同地域ECS测试",
          "maxLength": 200
        },
        {
          "field": "documentPreview",
          "label": "是否需文档预览",
          "required": false,
          "type": "boolean",
          "description": "小程序文档预览需开通IMM WebOffice，并通过x-oss-process=doc/preview参数实现"
        },
        {
          "field": "logRetention",
          "label": "日志转存状态",
          "required": false,
          "type": "string",
          "enum": ["转存已开启", "未开启", "历史日志不可恢复"],
          "description": "实时日志查询仅保留近期数据，2025-03之前的日志不可恢复，需确认日志转存是否开启"
        },
        {
          "field": "lifecycleRuleType",
          "label": "生命周期规则类型",
          "required": false,
          "type": "string",
          "enum": ["最后修改时间", "最后访问时间", "不支持"],
          "description": "按最后访问时间过期的生命周期规则暂不支持（需单独权限申请），当前仅支持按最后修改时间"
        }
      ]
    },
    {
      "name": "购买/续费/欠费/计费/账单问题",
      "keywords": [
        "购买",
        "续费",
        "欠费",
        "计费",
        "账单",
        "存储包",
        "流量包",
        "费用"
      ],
      "categoryKeywords": [
        "购买",
        "续费",
        "欠费",
        "计费",
        "账单"
      ],
      "categoryHints": [
        "购买/续费/欠费/计费/账单问题"
      ],
      "collect": [
        {
          "field": "billingConfusionType",
          "label": "费用疑问类型",
          "required": true,
          "type": "string",
          "enum": ["存储包不覆盖流量费", "欠费原因", "账单查询", "费用争议", "其他"],
          "description": "客户最常见混淆：存储包不覆盖外网流量费，需明确疑问类型"
        },
        {
          "field": "bucketName",
          "label": "Bucket名称",
          "required": false,
          "type": "string",
          "description": "查询单个Bucket费用时提供",
          "maxLength": 64
        },
        {
          "field": "billingPeriod",
          "label": "账期",
          "required": false,
          "type": "string",
          "description": "涉及费用的具体账期，如2026-09",
          "maxLength": 64
        },
        {
          "field": "resourcePackType",
          "label": "资源包类型",
          "required": false,
          "type": "string",
          "enum": ["存储包", "流量包", "无", "不确定"],
          "description": "客户已购买的资源包类型，存储包和流量包覆盖范围不同"
        },
        {
          "field": "disputedAmount",
          "label": "争议金额",
          "required": false,
          "type": "string",
          "description": "具体争议的费用金额",
          "maxLength": 64
        },
        {
          "field": "accountTransferIntent",
          "label": "跨账号转移意向",
          "required": false,
          "type": "boolean",
          "description": "客户是否有跨账号转移资源包的需求"
        },
        {
          "field": "questionDescription",
          "label": "问题说明",
          "required": true,
          "type": "string",
          "description": "说明费用疑问、期望核实内容和相关时间",
          "maxLength": 1000
        },
        {
          "field": "redundancyTypeMismatch",
          "label": "资源包不抵扣原因",
          "required": false,
          "type": "string",
          "enum": ["资源包冗余类型不匹配", "Bucket存储类型不匹配", "容量超限"],
          "description": "资源包不抵扣的三大根因：资源包冗余类型（本地/同城/跨区域）与Bucket存储类型不匹配，或资源包容量已用尽"
        },
        {
          "field": "snapshotStorage",
          "label": "是否涉及快照存储费",
          "required": false,
          "type": "boolean",
          "description": "快照存储费为独立计费项，不能使用OSS资源包抵扣"
        }
      ]
    },
    {
      "name": "OSS API/SDK使用",
      "keywords": [
        "API",
        "SDK",
        "签名",
