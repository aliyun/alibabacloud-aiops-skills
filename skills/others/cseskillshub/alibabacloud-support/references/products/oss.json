          "description": "使用的SDK编程语言，不同语言的签名实现路径不同"
        },
        {
          "field": "sdkVersion",
          "label": "SDK版本",
          "required": true,
          "type": "string",
          "description": "SDK具体版本号，如aliyun-oss-go-sdk v3.0.2",
          "maxLength": 64
        },
        {
          "field": "apiEndpoint",
          "label": "API Endpoint",
          "required": true,
          "type": "string",
          "description": "调用的OSS Endpoint地址，如oss-cn-hangzhou.aliyuncs.com",
          "maxLength": 200
        },
        {
          "field": "errorCode",
          "label": "错误码",
          "required": true,
          "type": "string",
          "description": "OSS返回的错误码，如SignatureDoesNotMatch、NoSuchBucket、AccessDenied",
          "maxLength": 120
        },
        {
          "field": "errorMessage",
          "label": "错误信息",
          "required": true,
          "type": "string",
          "description": "完整的错误返回信息，用于定位签名或参数问题",
          "maxLength": 1000
        },
        {
          "field": "requestId",
          "label": "RequestId",
          "required": false,
          "type": "string",
          "description": "请求ID，需在3天内提供（日志保留期限）",
          "maxLength": 120
        },
        {
          "field": "regionId",
          "label": "地域",
          "required": false,
          "type": "string",
          "description": "Bucket所在地域，部分功能在不同地域支持情况不同",
          "maxLength": 64
        },
        {
          "field": "signatureVersion",
          "label": "签名版本",
          "required": false,
          "type": "string",
          "enum": ["V1", "V4"],
          "description": "使用的签名版本，V4签名格式与V1不同，常见签名不匹配问题"
        },
        {
          "field": "refererValidation",
          "label": "Referer防盗链验证",
          "required": false,
          "type": "string",
          "description": "Referer防盗链配置及客户端IP验证信息，用于排查AccessDenied类问题",
          "maxLength": 500
        },
        {
          "field": "webpDecode",
          "label": "是否需WebP解码",
          "required": false,
          "type": "boolean",
          "description": "WebP图片解码需提交白名单开通后才能使用"
        },
        {
          "field": "crossAccountKMS",
          "label": "是否跨账号KMS加密",
          "required": false,
          "type": "boolean",
          "description": "跨账号KMS加密当前无成熟方案，需提前告知客户"
        }
      ]
    },
