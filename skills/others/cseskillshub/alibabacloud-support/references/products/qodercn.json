        "客户端"
      ],
      "categoryHints": [
        "Qoder CN Desktop问题（IDEA/PyCharm插件登录/Token Plan配置/Quest迁移/VSCode不可用）"
      ],
      "collect": [
        {
          "field": "desktopPlugin",
          "label": "Desktop插件类型",
          "required": true,
          "type": "string",
          "enum": ["IDEA", "PyCharm", "VSCode", "Qoder CN IDE", "WebStorm", "其他"],
          "description": "IDEA插件登录问题常因配置文件损坏；PyCharm需代理白名单"
        },
        {
          "field": "tokenPlanConfig",
          "label": "Token Plan配置状态",
          "required": false,
          "type": "string",
          "enum": ["未配置", "已配置", "配置失败", "不适用"],
          "description": "Token Plan在Qoder中需配置Custom Models"
        },
        {
          "field": "questMigration",
          "label": "Quest迁移状态",
          "required": false,
          "type": "string",
          "enum": ["待迁移", "已迁移", "迁移中", "不适用"],
          "description": "Quest窗口将于2026-10-15停用，需迁移至Qoder CN"
        },
        {
          "field": "proxyWhitelist",
          "label": "代理白名单",
          "required": false,
          "type": "string",
          "description": "需添加代理白名单的域名：qoder.cn 和 qoder.console.aliyun.com",
          "maxLength": 300
        },
        {
          "field": "configCorrupted",
          "label": "配置文件是否损坏",
          "required": false,
          "type": "boolean",
          "description": "IDEA插件用户数据迁移过程中可能配置文件损坏"
        },
        {
          "field": "desktopVersion",
          "label": "Desktop版本",
          "required": false,
          "type": "string",
          "description": "Qoder CN Desktop客户端版本号",
          "maxLength": 64
        },
        {
          "field": "questionDescription",
          "label": "问题描述",
          "required": true,
          "type": "string",
          "description": "说明Desktop问题的具体表现",
          "maxLength": 1000
        }
      ]
    },
    {
      "name": "Qoder CN CLI",
      "keywords": [
        "CLI",
        "命令行",
        "remote-control",
        "模型配置",
        "Token Plan不支持",
