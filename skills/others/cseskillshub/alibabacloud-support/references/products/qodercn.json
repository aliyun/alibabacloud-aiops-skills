    {
      "name": "QoderCn通用问题",
      "keywords": [
        "模型断连",
        "系统不可用",
        "Token Plan插件",
        "多模型不可用",
        "企业升级",
        "输出长度限制"
      ],
      "categoryKeywords": [
        "通用",
        "系统",
        "模型"
      ],
      "categoryHints": [
        "QoderCn通用问题（模型断连/系统不可用/Token Plan插件/多模型不可用需企业升级）"
      ],
      "collect": [
        {
          "field": "issueType",
          "label": "问题子类",
          "required": true,
          "type": "string",
          "enum": ["模型断连", "系统不可用", "Token Plan插件", "模型不可用"],
          "description": "模型断连=模型连接中断；系统不可用=整体不可用需后端修复；Token Plan插件=WebStorm等插件中使用Token Plan；模型不可用=需企业版升级"
        },
        {
          "field": "modelName",
          "label": "模型名称",
          "required": false,
          "type": "string",
          "enum": ["qwen3.8-max", "qwen3.8-flash-next", "DeepSeek-V4.1-Flash", "Claude", "GPT", "Auto", "其他"],
          "description": "涉及的模型名称，如 DeepSeek-V4.1-Flash 深度思考模式可能触发输出长度限制"
        },
        {
          "field": "systemStatus",
          "label": "系统状态",
          "required": false,
          "type": "string",
          "enum": ["完全不可用", "部分不可用", "间歇性故障", "正常"],
          "description": "系统整体可用性状态，不可用时需后端修复"
        },
        {
          "field": "enterpriseUpgrade",
          "label": "企业升级需求",
          "required": false,
          "type": "string",
          "enum": ["需升级企业版", "已为企业版", "不需要升级", "不确定"],
          "description": "多模型不可用可能需要升级至企业版"
        },
