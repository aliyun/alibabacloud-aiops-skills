{
  "product": "qodercn",
  "aliases": [
    "QoderCn",
    "Qoder CN",
    "qoder.com.cn",
    "千问编程"
  ],
  "issueTypes": [
    {
      "name": "产品问题咨询",
      "keywords": [
        "产品咨询",
        "功能使用",
        "风控拦截",
        "Credits消耗",
        "产品区别",
        "Qoder vs Qoder CN",
        "自动保存",
        "私有部署",
        "Seats减少"
      ],
      "categoryKeywords": [
        "产品",
        "咨询",
        "功能",
        "风控",
        "Credits"
      ],
      "categoryHints": [
        "QoderCn产品问题咨询（风控拦截/Credits优先级/功能使用/产品区别）"
      ],
      "collect": [
        {
          "field": "issueType",
          "label": "问题子类",
          "required": true,
          "type": "string",
          "enum": ["风控拦截", "Credits优先级", "功能使用", "产品区别"],
          "description": "风控拦截=活动入口/Credits被风控拦截；Credits优先级=消耗顺序疑问；功能使用=产品功能操作问题；产品区别=Qoder vs Qoder CN区别"
        },
        {
          "field": "riskControlStatus",
          "label": "风控拦截状态",
          "required": false,
          "type": "string",
          "enum": ["已拦截", "已解除", "待处理", "无拦截"],
          "description": "问题子类为风控拦截时填写，描述当前风控状态"
        },
        {
          "field": "creditsPriority",
          "label": "Credits消耗优先级疑问",
          "required": false,
          "type": "string",
          "enum": ["赠送Credits优先", "资源包优先", "混合抵扣", "不清楚"],
          "description": "千问模型消耗顺序：赠送Credits优先于资源包抵扣，与用户预期可能不同"
        },
        {
          "field": "productComparison",
          "label": "产品对比说明",
          "required": false,
          "type": "string",
          "enum": ["Qoder vs Qoder CN", "Qoder CN vs 千问编程", "Credits不可互换", "无对比"],
          "description": "Qoder与Qoder CN为独立产品线，Credits不可互换"
        },
        {
          "field": "featureName",
          "label": "咨询功能名称",
          "required": false,
          "type": "string",
          "description": "涉及的具体功能名称，如Auto-save、私有部署、Seats管理",
          "maxLength": 120
        },
        {
          "field": "questionDescription",
          "label": "问题描述",
          "required": true,
          "type": "string",
          "description": "说明遇到的问题、当前情况和期望结果",
          "maxLength": 1000
        },
        {
          "field": "subscriptionType",
          "label": "当前套餐",
          "required": false,
          "type": "string",
          "enum": ["免费版", "Pro", "Pro+", "Ultra", "团队版", "企业版"],
          "description": "用户当前订阅的套餐类型"
        }
      ]
    },
    {
      "name": "开通/购买/套餐变配/费用问题",
      "keywords": [
        "开通",
        "购买",
        "套餐",
        "变配",
        "费用",
        "资源包到期",
        "新用户试用",
        "续费奖励",
        "学生优惠",
        "VSCode插件Deprecated"
      ],
      "categoryKeywords": [
        "开通",
        "购买",
        "套餐",
        "费用",
        "续费"
      ],
      "categoryHints": [
        "QoderCn开通/购买/套餐变配/费用问题（含试用/续费奖励/学生优惠/VSCode迁移）"
      ],
      "collect": [
        {
          "field": "subscriptionType",
          "label": "目标套餐",
          "required": false,
          "type": "string",
          "enum": ["Pro", "Pro+", "Ultra", "团队版", "企业版"],
          "description": "用户希望开通或变更的目标套餐"
        },
        {
          "field": "creditsPackExpiry",
          "label": "Credits资源包到期时间",
          "required": false,
          "type": "string",
          "description": "资源包到期日期，千问模型优先消耗赠送Credits而非资源包",
          "maxLength": 64
        },
        {
          "field": "trialCredits",
          "label": "试用Credits状态",
          "required": false,
          "type": "string",
          "enum": ["未到账", "部分到账", "已到账", "已过期"],
          "description": "新用户Pro Trial赠送300 Credits的到账状态"
        },
        {
          "field": "renewalBonus",
          "label": "续费奖励状态",
          "required": false,
          "type": "string",
          "enum": ["未发放", "已发放", "不符合条件", "需到期前续费"],
          "description": "续费奖励需在到期前完成续费才能获得"
        },
        {
          "field": "studentCoupon",
          "label": "学生优惠券",
          "required": false,
          "type": "string",
          "enum": ["未领取", "已领取", "控制台购买", "官网不可用"],
          "description": "学生300元优惠券仅限控制台购买，官网不支持"
        },
        {
          "field": "vscodeMigration",
          "label": "VSCode插件迁移",
          "required": false,
          "type": "string",
          "enum": ["已迁移", "待迁移", "不适用"],
          "description": "VSCode插件已Deprecated，需迁移至Qoder CN IDE或JetBrains插件"
        },
        {
          "field": "orderNumber",
          "label": "订单号",
          "required": false,
          "type": "string",
          "description": "涉及的订单编号",
          "maxLength": 120
        },
        {
          "field": "questionDescription",
          "label": "问题描述",
          "required": true,
          "type": "string",
          "description": "说明开通/购买/变配/费用方面的具体问题",
          "maxLength": 1000
        }
      ]
    },
    {
      "name": "退订问题",
      "keywords": [
        "退订",
        "退款",
        "取消订阅",
        "Seats取消",
        "Token清零",
        "自动续费",
        "到期不可退"
      ],
      "categoryKeywords": [
        "退订",
        "退款",
        "取消",
        "续费"
      ],
      "categoryHints": [
        "QoderCn退订问题（退款链接/到期不可退/企业Seats取消/Token清零/自动续费争议）"
      ],
      "collect": [
        {
          "field": "refundStatus",
          "label": "退款状态",
          "required": true,
          "type": "string",
          "enum": ["未到期可退", "已到期不可退", "已退款", "审核中"],
          "description": "到期后不可退款；未到期可通过退款链接申请"
        },
        {
          "field": "refundLink",
          "label": "退款链接",
          "required": false,
          "type": "string",
          "description": "特殊退款链接位于 usercenter2.aliyun.com",
          "maxLength": 253
        },
        {
          "field": "seatCancellation",
          "label": "Seats取消类型",
          "required": false,
          "type": "string",
          "enum": ["个人版取消", "团队版Seats减少", "企业版Seats取消", "国际版Teams取消", "不适用"],
          "description": "企业Seats取消需联系商务团队；国际版Teams需云市场审批"
        },
        {
          "field": "tokenCleared",
          "label": "Token是否清零",
          "required": false,
          "type": "boolean",
          "description": "退订后Token余额是否被清零"
        },
        {
          "field": "complaintRisk",
          "label": "投诉风险等级",
          "required": false,
          "type": "string",
          "enum": ["无投诉", "一般抱怨", "威胁法律行动", "已投诉监管"],
          "description": "客户对退款结果的态度，威胁法律行动需升级处理"
        },
        {
          "field": "autoRenewalDispute",
          "label": "自动续费争议",
          "required": false,
          "type": "string",
          "enum": ["不知情自动续费", "续费金额争议", "取消续费未生效", "无争议"],
          "description": "自动续费相关的争议类型"
        },
        {
          "field": "orderNumber",
          "label": "订单号",
          "required": false,
          "type": "string",
          "description": "涉及退订的订单编号",
          "maxLength": 120
        },
        {
          "field": "subscriptionExpiry",
          "label": "套餐到期时间",
          "required": false,
          "type": "string",
          "description": "当前订阅的到期日期",
          "maxLength": 64
        },
        {
          "field": "questionDescription",
          "label": "问题描述",
          "required": true,
          "type": "string",
          "description": "说明退订原因和期望处理结果",
          "maxLength": 1000
        }
      ]
    },
    {
      "name": "插件端功能问题",
      "keywords": [
        "插件",
        "灵码迁移",
        "模型选择",
        "Auto智能路由",
        "性能慢",
        "IDE审批",
        "Repo Wiki",
        "专家团队",
        "Custom Models"
      ],
      "categoryKeywords": [
        "插件",
        "IDE",
        "模型",
        "灵码"
      ],
      "categoryHints": [
        "QoderCn插件端功能问题（灵码迁移/模型选择/性能/IDE审批）"
      ],
      "collect": [
        {
          "field": "pluginType",
          "label": "插件类型",
          "required": true,
          "type": "string",
          "enum": ["VSCode", "JetBrains", "Qoder CN IDE", "灵码"],
          "description": "涉及的插件类型，灵码已停用需迁移至Qoder CN"
        },
        {
          "field": "modelSelection",
          "label": "模型选择方式",
          "required": false,
          "type": "string",
          "enum": ["Auto", "Claude", "GPT", "DeepSeek", "千问模型", "自定义模型"],
          "description": "Auto为智能路由（模型池非固定模型）；Claude/GPT需通过Custom Models配置鉴权参数"
        },
        {
          "field": "lingmaMigration",
          "label": "灵码迁移状态",
          "required": false,
          "type": "string",
          "enum": ["已完成迁移", "待迁移", "迁移中遇到问题", "不适用"],
          "description": "灵码已停止迭代，需迁移至Qoder CN"
        },
        {
          "field": "approvalSetting",
          "label": "审批设置类型",
          "required": false,
          "type": "string",
          "enum": ["终端审批", "代码变更审批", "无审批", "不适用"],
          "description": "IDE内审批功能设置问题"
        },
        {
          "field": "performanceIssue",
          "label": "性能问题",
          "required": false,
          "type": "string",
          "enum": ["响应慢", "内存占用高", "卡顿", "崩溃", "无性能问题"],
          "description": "插件运行性能问题表现"
        },
        {
          "field": "ideVersion",
          "label": "IDE版本",
          "required": false,
          "type": "string",
          "description": "用户使用的IDE及版本号，如 IntelliJ IDEA 2024.3",
          "maxLength": 120
        },
        {
          "field": "pluginVersion",
          "label": "插件版本",
          "required": false,
          "type": "string",
          "description": "Qoder CN插件版本号",
          "maxLength": 64
        },
        {
          "field": "questionDescription",
          "label": "问题描述",
          "required": true,
          "type": "string",
          "description": "说明插件功能问题的具体表现和期望结果",
          "maxLength": 1000
        }
      ]
    },
    {
      "name": "登录问题",
      "keywords": [
        "登录失败",
        "登录异常",
        "灵码停用",
        "版本更新",
        "SSH断连",
        "RAM子账号",
        "阿里云账号"
      ],
      "categoryKeywords": [
        "登录",
        "账号",
        "认证"
      ],
      "categoryHints": [
        "QoderCn登录问题（灵码停用/版本更新破坏/SSH断连/风控）"
      ],
      "collect": [
        {
          "field": "loginIssueType",
          "label": "登录问题子类",
          "required": true,
          "type": "string",
          "enum": ["灵码停用", "版本更新", "SSH断连", "风控拦截", "其他"],
          "description": "灵码客户端停用后登录失败；版本更新（如v3.35）破坏登录状态"
        },
        {
          "field": "loginMethod",
          "label": "登录方式",
          "required": true,
          "type": "string",
          "enum": ["阿里云账号", "RAM子账号", "灵码账号", "其他"],
          "description": "Qoder CN登录=阿里云登录（邮箱+RAM），Desktop不支持灵码账号登录"
        },
        {
          "field": "versionInfo",
          "label": "版本信息",
          "required": false,
          "type": "string",
          "description": "出现问题的版本号，如 v3.35",
          "maxLength": 64
        },
        {
          "field": "sshBroken",
          "label": "SSH断连详情",
          "required": false,
          "type": "string",
          "description": "SSH连接断开的具体场景和错误信息",
          "maxLength": 500
        },
        {
          "field": "clientType",
          "label": "客户端类型",
          "required": false,
          "type": "string",
          "enum": ["VSCode插件", "JetBrains插件", "Qoder CN IDE", "Qoder CN Desktop", "Qoder CN CLI"],
          "description": "出现登录问题的客户端类型"
        },
        {
          "field": "errorMessage",
          "label": "错误信息",
          "required": false,
          "type": "string",
          "description": "登录时显示的完整错误信息",
          "maxLength": 1000
        },
        {
          "field": "occurrenceTime",
          "label": "发生时间",
          "required": false,
          "type": "string",
          "description": "登录问题首次发生的时间",
          "maxLength": 64
        }
      ]
    },
    {
      "name": "Qoder CN Desktop",
      "keywords": [
        "Desktop",
        "IDEA插件",
        "PyCharm插件",
        "Token Plan",
        "Quest迁移",
        "VSCode不可用"
      ],
      "categoryKeywords": [
        "Desktop",
