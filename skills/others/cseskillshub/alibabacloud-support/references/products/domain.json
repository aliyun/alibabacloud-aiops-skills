{
  "product": "domain",
  "aliases": [
    "域名",
    "域名服务",
    "Domain",
    "万网"
  ],
  "issueTypes": [
    {
      "name": "域名信息查询",
      "keywords": [
        "域名查询",
        "归属查询",
        "到期时间",
        "备案状态",
        "域名状态查询"
      ],
      "categoryKeywords": [
        "查询",
        "信息",
        "归属"
      ],
      "categoryHints": [
        "域名信息查询"
      ],
      "collect": [
        {
          "field": "domainName",
          "label": "域名",
          "required": true,
          "type": "string",
          "description": "需查询的域名，如 www.example.com",
          "maxLength": 253
        },
        {
          "field": "queryType",
          "label": "查询类型",
          "required": true,
          "type": "string",
          "enum": ["归属", "到期时间", "备案状态", "域名状态", "其他"],
          "description": "客户期望查询的具体信息类型"
        },
        {
          "field": "accountUid",
          "label": "账号UID",
          "required": false,
          "type": "string",
          "description": "查询域名归属时需提供的账号标识（UID/登录账号/手机号）",
          "maxLength": 120
        },
        {
          "field": "domainStatus",
          "label": "域名当前状态",
          "required": false,
          "type": "string",
          "enum": ["正常", "已过期", "赎回期", "已删除", "不确定"],
          "description": "域名当前运行状态，影响查询结果"
        },
        {
          "field": "questionDescription",
          "label": "问题描述",
          "required": true,
          "type": "string",
          "description": "说明查询目的和期望获取的具体信息",
          "maxLength": 1000
        }
      ]
    },
    {
      "name": "域名注册/续费/赎回",
      "keywords": [
        "域名注册",
