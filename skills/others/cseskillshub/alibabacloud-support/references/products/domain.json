        "续费",
        "赎回"
      ],
      "categoryHints": [
        "域名注册/续费/赎回"
      ],
      "collect": [
        {
          "field": "domainName",
          "label": "域名",
          "required": true,
          "type": "string",
          "description": "涉及的域名，如 test.cn",
          "maxLength": 253
        },
        {
          "field": "registrationStatus",
          "label": "域名注册状态",
          "required": true,
          "type": "string",
          "enum": ["未注册", "已注册", "已过期", "赎回期", "已删除"],
          "description": "域名当前的注册状态，决定可用操作"
        },
        {
          "field": "orderNumber",
          "label": "订单号",
          "required": false,
          "type": "string",
          "description": "注册/续费/赎回的订单编号",
          "maxLength": 120
        },
        {
          "field": "registrationPeriod",
          "label": "注册/续费年限",
          "required": false,
          "type": "string",
          "description": "注册或续费的年限，赎回期为过期后30天内",
          "maxLength": 64
        },
        {
          "field": "redemptionDeadline",
          "label": "赎回截止时间",
          "required": false,
          "type": "string",
          "description": "赎回期域名的最后赎回时间，精确到日期",
          "maxLength": 64
        },
        {
          "field": "errorMessage",
          "label": "错误信息",
          "required": false,
          "type": "string",
          "description": "注册/续费/赎回失败时的错误提示",
          "maxLength": 1000
        },
        {
          "field": "questionDescription",
          "label": "问题描述",
          "required": true,
          "type": "string",
          "description": "说明具体需求和遇到的问题",
          "maxLength": 1000
        }
      ]
    },
